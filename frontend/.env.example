# FairMod frontend environment configuration.
#
# VITE_FAIRMOD_CONTRACT_ADDRESS: the deployed FairMod contract address on
# StudioNet. Leave unset/empty until a real address exists — the frontend
# refuses all reads/writes rather than fabricating one (see
# src/config/network.ts). Changing this is the ONLY step required to point
# the frontend at a new deployment; nothing else in the codebase hardcodes
# an address.
VITE_FAIRMOD_CONTRACT_ADDRESS=

# VITE_FAIRMOD_DEV_MODE: "true" enables development-only fixture data paths
# (src/dev/fixtures.ts) for visual/component development. MUST remain unset
# ("false"/absent) in any production build/deployment.
VITE_FAIRMOD_DEV_MODE=false
